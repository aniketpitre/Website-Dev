     "code": "import pandas as pd\nimport openpyxl\nimport csv\nimport base64\nimport io\n\ndef main(input):\n  file_content= input['file_content']\n  message_bytes = base64.b64decode(file_content)\n  toread = io.BytesIO(message_bytes)\n  count = 0\n  \n  wb = openpyxl.load_workbook(filename=toread, read_only=True)\n  ws = wb['Sheet1']\n  \n  for row in ws.rows:\n    count += 1       \n  \n  wb.close()\n  \n  return {'count': count}\n",
