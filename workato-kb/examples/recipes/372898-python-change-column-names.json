      "number": 6,
      "provider": "py_eval",
      "name": "invoke_custom_py_code",
      "as": "fa88fc27",
      "keyword": "action",
      "dynamicPickListSelection": {},
      "toggleCfg": {},
      "input": {
       "code": "import pandas as pd\nimport openpyxl\nimport csv\nimport base64\nimport io\n\ndef main(input):\n  file_content= input['file_content']\n  message_bytes = base64.b64decode(file_content)\n  toread = io.BytesIO(message_bytes)\n  string = \"\"\n  count = 0\n  wb = openpyxl.load_workbook(filename=toread, read_only=True)\n  ws = wb['Sheet1']\n  \n  for row in ws.rows:\n    count += 1\n    if count < int(input['offset']):\n    \tcontinue\n    if count > (int(input['offset']) + int(input['page_size'])):\n    \tbreak\n    l = list(row)\n    for i in range(len(l)):\n        if i == len(l) - 1:\n            string += str(l[i].value)\n        else:\n            string += str(l[i].value) + ','\n    string += str('\\n')            \n  \n  wb.close()\n  \n  return {'csv': string}\n",
       "code_input": {
        "schema": "[{\"control_type\":\"text\",\"label\":\"file_content\",\"name\":\"file_content\",\"type\":\"string\",\"optional\":true},{\"name\":\"offset\",\"type\":\"string\",\"optional\":true,\"label\":\"offset\",\"control_type\":\"text\"},{\"name\":\"page_size\",\"type\":\"string\",\"optional\":true,\"label\":\"page_size\",\"control_type\":\"text\"}]",
        "data": {
         "file_content": "=_('data.google_drive.a227f39d.payload').to_s.encode_base64",
         "offset": "#{_('data.workato_variable.6461c6c3.offset_variable')}",
         "page_size": "#{_('data.workato_variable.6461c6c3.limit')}"
        }
       },
       "name": "Excel to CSV",
       "code_output_schema_json": "[{\"control_type\":\"text\",\"label\":\"csv\",\"name\":\"csv\",\"type\":\"string\",\"optional\":false}]"
